LANGGRAPH_RUNTIME_EDITION=pg
DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/langgraph
REDIS_URI=redis://localhost:6379/0
GRAPHHARBOR_ENV=development
# Production requires platform-api delegation JWTs. Do not use a demo token.
# GRAPHHARBOR_JWT_ISSUER=https://platform-api.example.internal
# Must match platform-api's runtime_delegation_audience (default: runtime-service).
# GRAPHHARBOR_JWT_AUDIENCE=runtime-service
# GRAPHHARBOR_JWT_ALGORITHMS=RS256
# GRAPHHARBOR_JWT_JWKS_URL=https://platform-api.example.internal/.well-known/jwks.json
# GRAPHHARBOR_JWT_LEEWAY_SECONDS=30
# Optional per-deployment Redis namespace when multiple runtimes share a Redis DB.
# GRAPHHARBOR_REDIS_PREFIX=graphharbor:runtime
# Optional: redis-py client pool size (default 64). Fanout uses 2 shared
# pattern subscriptions + 1 wake listener; raise only if you have many replicas
# sharing one process pool incorrectly.
# REDIS_MAX_CONNECTIONS=64
# Retry/reaper controls. Infrastructure failures are capped at three attempts.
# GRAPHHARBOR_RETRY_BASE_SECONDS=1
# GRAPHHARBOR_REAPER_INTERVAL_SECONDS=5
